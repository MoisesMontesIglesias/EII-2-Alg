public class Vector6 {
	static int []v;
	static int []w;

	public static void main (String arg [] )
	{
		int n= Integer.parseInt(arg[0]);  //tamaño del problema leido de línea de comandos
		v = new int [n] ;

		rellena (v);
		escribe (v);

		int s=suma (v);
		System.out.println ("Suma de los elementos del vector = "+ s);

		int [] m = new int [2];
